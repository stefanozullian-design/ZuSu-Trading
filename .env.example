# ---------------------------------------------------------------------------
# ZuSu Trading — environment template.
# Copy to .env and fill in. NEVER commit a real .env or paste secrets into git.
# In production these belong in a secrets manager, not a file (§53).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database and cache
DATABASE_URL=postgresql://zusu:zusu@localhost:5432/zusu_trading?schema=public
REDIS_URL=redis://localhost:6379

# Secrets — generate fresh values, do not reuse these placeholders.
#   JWT_SECRET / COOKIE_SECRET:      openssl rand -base64 48
#   CREDENTIAL_ENCRYPTION_KEY:       openssl rand -base64 32   (must decode to 32 bytes)
JWT_SECRET=replace-me-with-at-least-32-characters-of-random
COOKIE_SECRET=replace-me-with-at-least-32-characters-of-random
CREDENTIAL_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64-encoded=

# Session lifetimes (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
MFA_TOKEN_TTL_SECONDS=300

# Trading environment this deployment runs in: DEMO | PAPER | LIVE
DEFAULT_ENVIRONMENT=DEMO
# Master switch for real-money trading. Keep false unless you mean it.
ALLOW_LIVE_TRADING=false

# Web client origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173
# Set false only for local plain-HTTP development
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10

# Deterministic seed for the demo market simulator
DEMO_SEED=20260101

# Claude (Phase 6 — unused until the AI engine lands)
# ANTHROPIC_API_KEY=
